---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="relative isolate grid min-h-[80svh] place-items-center overflow-hidden pt-24 text-center">
    <div class="bg-aurora absolute inset-0 -z-10"></div>
    <div class="container-x">
      <p class="font-display text-[7rem] font-black leading-none text-gradient md:text-[10rem]">404</p>
      <h1 class="mt-2 text-3xl font-extrabold text-white">This page isn’t verified.</h1>
      <p class="mt-3 text-mute">It may have moved, or never existed.</p>
      <a href="/" class="btn btn-primary mt-8">Back to home</a>
    </div>
  </section>
</Base>
