---
import Base from '../../layouts/Base.astro';
interface Props { title: string; description: string; updated: string; summary?: string }
const { title, description, updated, summary } = Astro.props;
---
<Base title={title} description={description}>
  <article class="relative pt-32 pb-24">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-4 text-4xl font-black text-white md:text-5xl">{title}</h1>
      <p class="mt-3 text-sm text-mute">Effective {updated} · ORUMIND, Hyderabad, Telangana, India</p>
      {summary && <p class="mt-8 rounded-2xl border border-line bg-ink-2 p-5 text-zinc-300">{summary}</p>}
      <div class="prose-legal mt-6"><slot /></div>
      <p class="mt-14 text-sm text-mute">
        <a href="/privacy" class="hover:text-white">Privacy policy</a> · <a href="/terms" class="hover:text-white">Terms of service</a> · <a href="/data-deletion" class="hover:text-white">Data deletion</a>
      </p>
    </div>
  </article>
</Base>
