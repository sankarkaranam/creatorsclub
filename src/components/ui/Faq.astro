---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="mx-auto max-w-3xl divide-y divide-line rounded-3xl border border-line bg-ink-2/60" data-reveal>
  {items.map((item) => (
    <details class="group px-6 py-5 md:px-8">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-base font-bold text-white md:text-lg">
        {item.q}
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-ember transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-mute md:text-base">{item.a}</p>
    </details>
  ))}
</div>
