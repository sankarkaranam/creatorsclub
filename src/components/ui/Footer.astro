---
import { NAV, SITE } from '../../lib/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, url]) => url);
---
<footer class="relative border-t border-line bg-ink-2">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <Logo class="h-8" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-mute">
        The verified home for India’s creators and brands. {SITE.tagline}
      </p>
      {socials.length > 0 && (
        <div class="mt-5 flex gap-3">
          {socials.map(([name, url]) => (
            <a href={url} class="rounded-full border border-line px-3 py-1.5 text-xs capitalize text-mute hover:text-white" rel="noopener" target="_blank">{name}</a>
          ))}
        </div>
      )}
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">Explore</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-mute">
        {NAV.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">Product</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-mute">
        <li><a href="/platform#app" class="hover:text-white">Mobile app</a></li>
        <li><a href="/platform#consoles" class="hover:text-white">Instagram &amp; YouTube consoles</a></li>
        <li><a href="/platform#store" class="hover:text-white">Seller workspace</a></li>
        <li><a href={SITE.loginUrl} class="hover:text-white">Log in</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">Legal</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-mute">
        <li><a href="/privacy" class="hover:text-white">Privacy policy</a></li>
        <li><a href="/terms" class="hover:text-white">Terms of service</a></li>
        <li><a href="/data-deletion" class="hover:text-white">Data deletion</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-mute md:flex-row md:items-center md:justify-between">
      <p>© {year} {SITE.name}, a product of {SITE.company}. {SITE.location}.</p>
      <p>Made in India for creators everywhere.</p>
    </div>
  </div>
</footer>
