---
interface Props {
  eyebrow?: string;
  title: string;
  /** Words of the title to colour with the brand gradient. */
  highlight?: string;
  intro?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, highlight, intro, align = 'center' } = Astro.props;
const parts = highlight && title.includes(highlight) ? title.split(highlight) : null;
---
<div class:list={['max-w-3xl', align === 'center' ? 'mx-auto text-center' : '']} data-reveal>
  {eyebrow && <p class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-crimson"></span>{eyebrow}</p>}
  <h2 class="mt-4 text-3xl font-extrabold leading-[1.1] text-white sm:text-4xl md:text-5xl">
    {parts ? <>{parts[0]}<span class="text-gradient">{highlight}</span>{parts[1]}</> : title}
  </h2>
  {intro && <p class="mt-5 text-base leading-relaxed text-mute md:text-lg">{intro}</p>}
</div>
